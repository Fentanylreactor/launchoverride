#the mod name as displayed in-game
displayName: "Core Schematic Size Increase"

#the internal name of your mod
name: "loadoutsizeincreaser"

#your name
author: "Ketan"

#the fully qualified main class of the mod
main: "loadoutsizeincreaser.Main"

#the mod description as seen in the mod dialog
description: "Bump Core schematic size a bit, increasing it from core size +10 to core size +15."

#the mod version
version: 1.0

#the minimum game build required to run this mod
minGameVersion: 158

#this is a java mod
java: true
